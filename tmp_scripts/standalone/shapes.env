# Shared shape matrix. All three variant scripts source this so the
# baseline, wholereduce and unfused runs cover exactly the same points.
#
#   decode-time  : tiny batch, no LoRA delta
#   prefill-time : large batch, with LoRA delta
DECODE_T="8 16 32 63 128"
PREFILL_T="2048 4096 16384 32768"
WIDTHS="768 1024 1408 2048"

# Wall-clock pass: enough iterations that the loop is not startup noise.
iters_for() {
    if   [ "$1" -le 128  ]; then echo 2000
    elif [ "$1" -le 4096 ]; then echo 200
    else                         echo 50
    fi
}

# Profiled pass: msprof writes one row per launch, so keep the counts small.
prof_iters_for() {
    if   [ "$1" -le 128  ]; then echo 50
    elif [ "$1" -le 4096 ]; then echo 30
    else                         echo 20
    fi
}

# Emit "T W delta iters" lines. $1 = wall|prof
emit_shapes() {
    local mode=$1 T W it
    for W in $WIDTHS; do
        for T in $DECODE_T; do
            if [ "$mode" = prof ]; then it=$(prof_iters_for "$T"); else it=$(iters_for "$T"); fi
            echo "$T $W 0 $it"
        done
        for T in $PREFILL_T; do
            if [ "$mode" = prof ]; then it=$(prof_iters_for "$T"); else it=$(iters_for "$T"); fi
            echo "$T $W 1 $it"
        done
    done
}
